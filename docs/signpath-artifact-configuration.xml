<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the Windows release; paste it as the
  project's default artifact configuration (see docs/windows-signing.md).

  release.yml sends two signing requests per release. Each is a GitHub
  artifact (a zip) holding a single .exe:
    1. djimic-gui.exe: the app, signed before it goes into the installer and
       also shipped as the portable exe
    2. DJI Mic Control_<version>_x64-setup.exe: the NSIS installer
  Both carry the product name and version from gui/src-tauri/tauri.conf.json;
  release.yml passes that version as the "version" parameter.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="DJI Mic Control" product-version="${version}">
      <include path="*.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
